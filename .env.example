# Copy this file to .env and fill in your values for local development
# On Render.com, set these in Dashboard > Settings > Environment Variables

# Google Sheets Configuration
SPREADSHEET_ID=1Plh_0AodTomKLyP8zrBp9FOriHXVm_uGYIO4TVHSozg

# Option 1: Full service account JSON (recommended for Render)
# Paste the entire content of your service-account.json file here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2: Individual fields (fallback for local dev)
# GOOGLE_CLIENT_EMAIL=opencode-gsheet@gen-lang-client-0476777034.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GOOGLE_PROJECT_ID=gen-lang-client-0476777034

# Google Drive OAuth (for uploading files to personal Google Drive)
GOOGLE_DRIVE_FOLDER_ID=1cHwFk1bG8l__SEZC8DG853thOA5q8tLO
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token

# Server Configuration
PORT=8765
HOST=0.0.0.0

# Upload directory (optional, defaults to ./uploads/documents)
# UPLOAD_DIR=./uploads/documents
